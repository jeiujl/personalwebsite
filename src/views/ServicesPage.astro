---
import CTA from '../components/CTA.astro';
import PageHero from '../components/PageHero.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getCtaHref, site } from '../config/site';
import { getLang, pick } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getServices } from '../lib/content';

const lang = getLang(Astro.url);
const ctaHref = getCtaHref(lang);
const services = await getServices(lang);
const design = services.filter((s) => s.data.pillar === 'design');
const automation = services.filter((s) => s.data.pillar === 'automation');

// FAQ answers, in both languages. Keep them true to how you work and price.
const faqsEn = [
  {
    q: 'Do I need to be technical?',
    a: "Not at all. I handle the setup and explain everything in plain English. When we launch, I'll walk you and your team through it.",
  },
  {
    q: 'How much does it cost?',
    a: "Each service shows a starting price, in US dollars. After a free call I send a fixed quote that says exactly what's included, so you know the full price before any work starts. Ad spend and software subscriptions are billed to you directly, at cost.",
  },
  {
    q: 'Will the AI send things without me?',
    a: "Only what you've approved. Routine messages, like a text back after a missed call, run on their own once you've signed off the wording. Quotes, prices, contracts and anything unusual wait for your OK, and a person takes over whenever a customer needs one.",
  },
  {
    q: "What if my customers don't want to talk to a bot?",
    a: 'They usually never have to. Most of what I build is fast texts and emails written in your words, and anyone who asks gets a real person. If you want to test it first, start with after-hours and missed calls only.',
  },
  {
    q: 'How long does a project take?',
    a: 'It depends on the size of the project. After our call, your proposal will include a timeline you can plan around.',
  },
  {
    q: 'Can you work with the tools I already use?',
    a: "Usually, yes. I connect to your existing email, calendar, CRM, forms and spreadsheets wherever I can, instead of making you switch. Tell me what you use and I'll let you know.",
  },
  {
    q: 'Who owns the accounts and data?',
    a: "You do. Your CRM, ad accounts and customer data stay in your business's name, so you're never locked in.",
  },
  {
    q: 'What happens after launch?',
    a: "The monthly plan keeps it working: I watch the system, fix anything that breaks, improve the messages and send you a report on what it produced. When you're ready, we add the next system.",
  },
];
const faqsZh = [
  {
    q: '我需要懂技术吗？',
    a: '完全不需要。所有设置都由我来做，并用大白话解释清楚。上线时，我会带你和团队熟悉一遍。',
  },
  {
    q: '费用是多少？',
    a: '每项服务都标有起步价（美元）。免费通话后，我会发给你一份固定报价，写明包含的所有内容，开工之前你就知道全部价格。广告费和软件订阅按实际费用由你直接支付。',
  },
  {
    q: 'AI 会不经过我就发消息吗？',
    a: '只会发送你确认过的内容。日常消息（比如未接来电后的自动短信）在你确认措辞后自动运行；报价、价格、合同和任何特殊情况都会先等你确认，客户需要时会由真人接手。',
  },
  {
    q: '如果我的客户不想和机器人对话怎么办？',
    a: '大多数时候他们根本不需要。我搭建的大部分内容是用你的口吻写的快速短信和邮件，任何人要求的话都可以转给真人。想先试试，可以只从下班后和未接来电开始。',
  },
  {
    q: '一个项目需要多长时间？',
    a: '取决于项目的规模。通话之后，你的方案里会包含一份可以参考的时间表。',
  },
  {
    q: '可以和我现在用的工具配合吗？',
    a: '通常可以。我会尽量连接你现有的邮箱、日历、CRM、表单和表格，而不是让你换工具。告诉我你在用什么，我会告诉你是否可行。',
  },
  {
    q: '账户和数据归谁所有？',
    a: '归你所有。你的 CRM、广告账户和客户数据都登记在你的企业名下，不会被绑定。',
  },
  {
    q: '上线之后呢？',
    a: '月度方案会让系统持续运转：我会监控系统、修复问题、优化消息内容，并发给你一份成果报告。准备好之后，我们再添加下一个系统。',
  },
];
const faqs = pick(lang, { en: faqsEn, zh: faqsZh });
const t = pick(lang, {
  en: {
    title: 'Services',
    description:
      'AI systems for small and mid-sized businesses: lead follow-up, AI agents for quotes, onboarding and paperwork, lead generation and websites, and custom apps. Clear starting prices.',
    intro: "Systems I build, run and improve for you. Start with the one that fixes your biggest leak, then add the next. Every price is a starting point; you get a fixed quote before any work starts.",
    design: 'Growth & build',
    designNote: 'Bring in more of the right customers',
    automation: 'AI systems',
    automationNote: 'Answer every lead and take the busywork off your team',
    howEyebrow: 'How it works',
    howTitle: 'Simple from start to finish',
    howIntro: "No confusing contracts or tech talk. Here's what working together looks like.",
    faqTitle: 'Questions people ask',
    unsure: 'Still unsure? Ask me on a free call.',
    book: 'Book a free call',
  },
  zh: {
    title: '服务',
    description: '为中小企业打造 AI 系统：潜在客户跟进、处理报价/入驻/文书的 AI 智能体、获客与网站，以及定制应用。起步价格清晰透明。',
    intro: '由我搭建、运行并持续优化的系统。先从解决你最大漏洞的那一个开始，再逐步添加。所有价格都是起步价；开工前你会拿到固定报价。',
    design: '增长与开发',
    designNote: '带来更多合适的客户',
    automation: 'AI 系统',
    automationNote: '回复每一位潜在客户，把繁琐工作从团队手中接过来',
    howEyebrow: '合作流程',
    howTitle: '从头到尾都很简单',
    howIntro: '没有复杂的合同，也没有技术术语。合作流程是这样的。',
    faqTitle: '常见问题',
    unsure: '还不确定？在免费通话里问我吧。',
    book: '预约免费通话',
  },
});

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout title={t.title} description={t.description} jsonLd={faqSchema}>
  <PageHero eyebrow={t.title} title={t.title} intro={t.intro} />

  <div class="grid-lines">
    <section class="container-page pt-16" aria-labelledby="automation-heading">
      <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-ink/80 pb-4" data-reveal>
        <h2 id="automation-heading" class="heading text-4xl sm:text-5xl">{t.automation}</h2>
        <p class="mono text-[12px] text-muted">{t.automationNote}</p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2" data-reveal-stagger>
        {automation.map((service) => <ServiceCard service={service} />)}
      </div>
    </section>

    <section class="container-page pt-20" aria-labelledby="design-heading">
      <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-ink/80 pb-4" data-reveal>
        <h2 id="design-heading" class="heading text-4xl sm:text-5xl">{t.design}</h2>
        <p class="mono text-[12px] text-muted">{t.designNote}</p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2" data-reveal-stagger>
        {design.map((service) => <ServiceCard service={service} />)}
      </div>
    </section>

    <section class="container-page pt-28">
      <SectionHeading eyebrow={t.howEyebrow} title={t.howTitle} intro={t.howIntro} />
      <div class="mt-12">
        <ProcessSteps />
      </div>
    </section>

    <section class="container-page grid gap-10 pt-28 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <div class="self-start lg:sticky lg:top-28">
        <SectionHeading eyebrow="FAQ" title={t.faqTitle} />
        <p class="mt-6 text-muted">{t.unsure}</p>
        <a href={ctaHref} class="btn-signal mt-6">{t.book} <span class="text-accent" aria-hidden="true">↗</span></a>
      </div>
      <div class="divide-y divide-line border-y border-line" data-reveal>
        {
          faqs.map((faq, i) => (
            <details class="group py-6">
              <summary class="flex cursor-pointer list-none items-center gap-5 text-lg font-medium [&::-webkit-details-marker]:hidden">
                <span class="mono text-[11px] text-muted">{String(i + 1).padStart(2, '0')}</span>
                <span class="flex-1">{faq.q}</span>
                <span
                  class="flex size-8 shrink-0 items-center justify-center rounded-full border border-line text-accent transition duration-300 group-open:rotate-45 group-hover:border-ink"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="mt-3 pr-12 pl-9 text-muted">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>

  <CTA />
</BaseLayout>
