---
import CTA from '../components/CTA.astro';
import LiveDemo from '../components/LiveDemo.astro';
import { getLang, pick } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDemos } from '../lib/content';

const lang = getLang(Astro.url);
const demos = await getDemos(lang);
const t = pick(lang, {
  en: {
    title: 'Demos',
    description: 'Live demo websites designed and built by Jerry Liu. Scroll through them right here: they are real, working sites.',
    about: 'About this demo',
    built: "What's inside",
    open: 'Open full site',
    cta: 'Want one like this?',
  },
  zh: {
    title: '演示',
    description: 'Jerry Liu 设计并搭建的在线演示网站。直接在这里滚动浏览：它们都是真实可用的网站。',
    about: '关于这个演示',
    built: '网站里有什么',
    open: '打开完整网站',
    cta: '想要一个这样的网站？',
  },
});
---

<BaseLayout title={t.title} description={t.description}>
  <h1 class="sr-only">{t.title}</h1>

  {
    demos.map((demo, i) => {
      const d = demo.data;
      return (
        <>
          {/* The live site first, full screen */}
          <LiveDemo demo={demo} eager={i === 0} />

          <section id={`details-${demo.id}`} class="grid-lines scroll-mt-16 border-b border-line py-16 sm:py-20">
            <div class="container-page grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
              <div data-reveal>
                <p class="eyebrow">{t.about}</p>
                <p class="heading mt-5 max-w-2xl text-3xl text-pretty sm:text-4xl">{d.summary}</p>
              </div>
              <div data-reveal>
                {d.highlights.length > 0 && (
                  <>
                    <p class="eyebrow">{t.built}</p>
                    <ul class="mt-4 space-y-2.5 text-[15px]">
                      {d.highlights.map((item) => (
                        <li class="flex gap-3">
                          <span class="mt-[0.7em] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                {d.tools.length > 0 && (
                  <ul class="mt-8 flex flex-wrap gap-2">
                    {d.tools.map((tool) => (
                      <li class="mono rounded-full border border-line px-3 py-1.5 text-[11px] leading-none">{tool}</li>
                    ))}
                  </ul>
                )}
                <a href={d.url} target="_blank" rel="noopener" class="btn-signal mt-10" data-magnetic>
                  {t.open} <span class="text-accent" aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </section>
        </>
      );
    })
  }

  <CTA title={t.cta} />
</BaseLayout>
