---
import CTA from '../components/CTA.astro';
import PageHero from '../components/PageHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getLang, pick } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { disciplines, getProjects } from '../lib/content';
import { disciplineKeys, disciplineLabel } from '../lib/disciplines';

const lang = getLang(Astro.url);
const projects = await getProjects(lang);
const t = pick(lang, {
  en: {
    title: 'Work',
    description:
      "Projects I've worked on, including the HayesX pilot companion app, Flowa AI, missed-call text-back for a dental company and promotion for Pursue Play.",
    eyebrow: 'Selected projects',
    intro: "Projects I've worked on, and what I did on each.",
    all: 'All work',
    filter: 'Filter projects',
    cta: 'Your project next',
  },
  zh: {
    title: '作品',
    description: '我参与过的项目，包括 HayesX 飞行员配套应用、Flowa AI、为牙科公司设置的未接来电自动回短信，以及 Pursue Play 的推广。',
    eyebrow: '精选项目',
    intro: '我参与过的项目，以及我在每个项目中做了什么。',
    all: '全部作品',
    filter: '筛选项目',
    cta: '下一个就是你的项目',
  },
});
const filters = [
  { value: 'all', label: t.all, hue: '' },
  ...disciplineKeys
    .filter((key) => projects.some((p) => p.data.category === key))
    .map((key) => ({ value: key, label: disciplineLabel(key, lang), hue: disciplines[key].hue })),
];
---

<BaseLayout title={t.title} description={t.description}>
  <PageHero eyebrow={t.eyebrow} title={t.title} intro={t.intro} />

  <section class="grid-lines pt-12 pb-8">
    <div class="container-page">
      <div class="flex flex-wrap gap-2" role="group" aria-label={t.filter}>
        {
          filters.map((f, i) => (
            <button
              type="button"
              data-filter={f.value}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="mono flex min-h-10 items-center gap-2 rounded-full border border-line px-4 py-2.5 text-[12px] leading-none text-muted transition-colors hover:text-ink aria-pressed:border-ink aria-pressed:text-ink"
            >
              {f.hue ? <span class="tag-dot" style={`background:${f.hue}`} /> : <span aria-hidden="true">+</span>}
              {f.label}
            </button>
          ))
        }
      </div>

      <div data-project-group class="mt-12">
        <div class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
          {projects.map((project) => <ProjectCard project={project} headingLevel="h2" />)}
        </div>
      </div>
    </div>
  </section>

  <CTA title={t.cta} />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const groups = document.querySelectorAll<HTMLElement>('[data-project-group]');

  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      groups.forEach((group) => {
        const cards = group.querySelectorAll<HTMLElement>('[data-category]');
        cards.forEach((card) => {
          card.hidden = filter !== 'all' && card.dataset.category !== filter;
        });
        // Hide a whole section when none of its projects match
        group.hidden = [...cards].every((card) => card.hidden);
      });
      document.dispatchEvent(new Event('projects:filtered'));
    }),
  );
</script>
