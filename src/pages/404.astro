---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="container-page flex flex-col items-start py-28">
    <p class="eyebrow">404</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">This page doesn't exist.</h1>
    <p class="mt-4 max-w-lg text-lg text-muted">
      The link may be old or mistyped. Here are some good places to start instead.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Go home</a>
      <a href="/work" class="btn-secondary">See my work</a>
      <a href="/contact" class="btn-secondary">Contact me</a>
    </div>
  </section>
</BaseLayout>
