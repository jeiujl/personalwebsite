---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <PageHero eyebrow="Page not found" title="404" intro="The link may be old or mistyped. Here are some good places to start instead.">
    <div class="flex flex-wrap gap-3">
      <a href="/" class="btn-signal">Go home <span class="text-accent" aria-hidden="true">↗</span></a>
      <a href="/work" class="btn-ghost">See my work</a>
      <a href="/contact" class="btn-ghost">Contact me</a>
    </div>
  </PageHero>
</BaseLayout>
