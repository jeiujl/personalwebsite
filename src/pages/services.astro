---
import CTA from '../components/CTA.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getServices } from '../lib/content';

const services = await getServices();
const design = services.filter((s) => s.data.pillar === 'design');
const automation = services.filter((s) => s.data.pillar === 'automation');

// TODO: adjust these answers to match how you work and price
const faqs = [
  {
    q: 'Do I need to be technical?',
    a: "Not at all. I handle the setup and explain everything in plain English. When we launch, I'll walk you and your team through it, and you'll get a short video guide to come back to.",
  },
  {
    q: 'How much does it cost?',
    a: "Every business is different, so I quote each project after a free call. Websites and app designs are a one-time project fee. The CRM platform is a monthly subscription that includes the software, setup and support. You'll always know the price before any work starts.",
  },
  {
    q: 'How long does a project take?',
    a: 'Most websites take 2–5 weeks. Automation setups usually go live in 1–2 weeks. App designs depend on the size of the app. Your proposal will include a timeline.',
  },
  {
    q: `What is ${site.platformName}?`,
    a: `${site.platformName} is an all-in-one platform for your leads, texts, emails, calendar, reviews and automations. I set it up for your business, brand it for you, and manage it, so you get one tool instead of five.`,
  },
  {
    q: 'Can you work with the tools I already use?',
    a: "Usually, yes. Most automations can connect to your existing email, calendar, forms and spreadsheets. Tell me what you use and I'll let you know.",
  },
  {
    q: 'What happens after launch?',
    a: "I don't disappear. I offer ongoing support for updates, new automations and questions, and I'm a message away if something needs attention.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Services"
  description="Website design, app design, an all-in-one CRM & marketing platform, and custom AI automations for small businesses."
  jsonLd={faqSchema}
>
  <section class="container-page pt-14 sm:pt-20">
    <SectionHeading
      as="h1"
      eyebrow="Services"
      title="What I can do for your business"
      intro="Pick one, or combine them. A new website works even harder with automations behind it."
    />
  </section>

  <section class="container-page mt-14" aria-labelledby="design-heading">
    <div class="flex items-baseline gap-3 border-b border-line pb-4" data-reveal>
      <h2 id="design-heading" class="text-2xl font-semibold tracking-tight">Design</h2>
      <p class="text-muted">Look established and win more customers online</p>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-2" data-reveal-stagger>
      {design.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <section class="container-page mt-16" aria-labelledby="automation-heading">
    <div class="flex items-baseline gap-3 border-b border-line pb-4" data-reveal>
      <h2 id="automation-heading" class="text-2xl font-semibold tracking-tight">Automation</h2>
      <p class="text-muted">Stop losing leads and win back hours every week</p>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-2" data-reveal-stagger>
      {automation.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <section class="container-page mt-24">
    <SectionHeading
      eyebrow="How it works"
      title="Simple from start to finish"
      intro="No confusing contracts or tech talk. Here's what working together looks like."
    />
    <div class="mt-10">
      <ProcessSteps />
    </div>
  </section>

  <section class="container-page mt-24">
    <SectionHeading eyebrow="FAQ" title="Questions people ask" />
    <div class="mt-8 max-w-3xl divide-y divide-line border-y border-line" data-reveal>
      {
        faqs.map((faq) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-semibold [&::-webkit-details-marker]:hidden">
              {faq.q}
              <span
                class="text-2xl leading-none font-normal text-muted transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-muted">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <CTA />
</BaseLayout>
