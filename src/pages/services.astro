---
import CTA from '../components/CTA.astro';
import PageHero from '../components/PageHero.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getServices } from '../lib/content';

const services = await getServices();
const design = services.filter((s) => s.data.pillar === 'design');
const automation = services.filter((s) => s.data.pillar === 'automation');

// TODO: adjust these answers to match how you work and price
const faqs = [
  {
    q: 'Do I need to be technical?',
    a: "Not at all. I handle the setup and explain everything in plain English. When we launch, I'll walk you and your team through it.",
  },
  {
    q: 'How much does it cost?',
    a: "Every business is different, so I quote each project after a free call. You'll always know the price before any work starts.",
  },
  {
    q: 'How long does a project take?',
    a: 'It depends on the size of the project. After our call, your proposal will include a timeline you can plan around.',
  },
  {
    q: site.platformName ? `What is ${site.platformName}?` : 'What is the all-in-one platform?',
    a: `${site.platformName || 'It'} is an all-in-one platform for your leads, texts, emails, calendar, reviews and automations. I set it up for your business, brand it for you, and manage it, so you get one tool instead of five.`,
  },
  {
    q: 'Can you work with the tools I already use?',
    a: "Usually, yes. Most automations can connect to your existing email, calendar, forms and spreadsheets. Tell me what you use and I'll let you know.",
  },
  {
    q: 'What happens after launch?',
    a: "I don't disappear. I offer ongoing support for updates, new automations and questions, and I'm a message away if something needs attention.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Services"
  description="Website design, app design, an all-in-one CRM & marketing platform, and custom AI automations for small businesses."
  jsonLd={faqSchema}
>
  <PageHero
    eyebrow="Services"
    title="Services"
    intro="Pick one, or combine them. A new website works even harder with automations behind it."
  />

  <div class="grid-lines">
    <section class="container-page pt-16" aria-labelledby="design-heading">
      <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-ink/80 pb-4" data-reveal>
        <h2 id="design-heading" class="heading text-4xl sm:text-5xl">Design</h2>
        <p class="mono text-[12px] text-muted">Look established and win more customers online</p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2" data-reveal-stagger>
        {design.map((service) => <ServiceCard service={service} />)}
      </div>
    </section>

    <section class="container-page pt-20" aria-labelledby="automation-heading">
      <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-ink/80 pb-4" data-reveal>
        <h2 id="automation-heading" class="heading text-4xl sm:text-5xl">Automation</h2>
        <p class="mono text-[12px] text-muted">Stop losing leads and win back hours every week</p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2" data-reveal-stagger>
        {automation.map((service) => <ServiceCard service={service} />)}
      </div>
    </section>

    <section class="container-page pt-28">
      <SectionHeading
        eyebrow="How it works"
        title="Simple from start to finish"
        intro="No confusing contracts or tech talk. Here's what working together looks like."
      />
      <div class="mt-12">
        <ProcessSteps />
      </div>
    </section>

    <section class="container-page pt-28">
      <SectionHeading eyebrow="FAQ" title="Questions people ask" />
      <div class="mt-10 max-w-3xl divide-y divide-line border-y border-line" data-reveal>
        {
          faqs.map((faq, i) => (
            <details class="group py-6">
              <summary class="flex cursor-pointer list-none items-baseline gap-5 text-lg font-medium [&::-webkit-details-marker]:hidden">
                <span class="mono text-[11px] text-muted">{String(i + 1).padStart(2, '0')}</span>
                <span class="flex-1">{faq.q}</span>
                <span class="mono text-accent transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="mt-3 pl-9 text-muted">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>

  <CTA />
</BaseLayout>
