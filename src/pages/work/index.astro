---
import CTA from '../../components/CTA.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
const filterLabels = { website: 'Websites', app: 'App design', automation: 'Automations' };
const filters = [
  { value: 'all', label: 'All work' },
  ...Object.entries(filterLabels)
    .filter(([value]) => projects.some((p) => p.data.category === value))
    .map(([value, label]) => ({ value, label })),
];
---

<BaseLayout
  title="Work"
  description="Websites, app designs and automations I've built for small businesses, and the results they delivered."
>
  <section class="container-page pt-14 sm:pt-20">
    <SectionHeading
      as="h1"
      eyebrow="Work"
      title="Projects & results"
      intro="Each project starts with a real business problem. Here's what I did and what changed."
    />

    <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter projects">
      {
        filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.value}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="rounded-full border border-line px-4 py-2 text-sm font-medium text-muted transition-colors hover:text-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-bg"
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <div id="project-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {projects.map((project) => <ProjectCard project={project} headingLevel="h2" />)}
    </div>
  </section>

  <CTA title="Want results like these?" />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid [data-category]');

  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      cards.forEach((card) => {
        card.hidden = filter !== 'all' && card.dataset.category !== filter;
      });
      document.dispatchEvent(new Event('projects:filtered'));
    }),
  );
</script>
