---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import CTA from '../../components/CTA.astro';
import Icon from '../../components/Icon.astro';
import Metrics from '../../components/Metrics.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import SampleBadge from '../../components/SampleBadge.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import WorkflowDiagram from '../../components/WorkflowDiagram.astro';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryLabels, getProjects, getTestimonials } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const testimonial = (await getTestimonials()).find((t) => t.data.project?.id === project.id);

const facts = [
  { label: 'Client', value: data.client },
  { label: 'My role', value: data.role },
  { label: 'Year', value: String(data.year) },
  ...(data.duration ? [{ label: 'Timeline', value: data.duration }] : []),
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  dateCreated: String(data.year),
  creator: { '@type': 'Person', name: site.name },
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout title={data.title} description={data.summary} type="article" jsonLd={schema}>
  <article>
    <header class="container-page pt-12 sm:pt-16">
      <a href="/work" class="inline-flex items-center gap-1.5 text-sm font-medium text-muted hover:text-ink">
        <Icon name="arrow-right" size={16} class="rotate-180" /> All work
      </a>
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <span class="badge">{categoryLabels[data.category]}</span>
        {data.sample && <SampleBadge />}
      </div>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        {data.title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-pretty text-muted">{data.summary}</p>

      <dl class="mt-10 grid grid-cols-2 gap-6 border-y border-line py-6 sm:grid-cols-4" data-reveal>
        {
          facts.map((f) => (
            <div>
              <dt class="text-sm text-muted">{f.label}</dt>
              <dd class="mt-1 font-medium">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <div class="container-page mt-10 space-y-10">
      {
        data.cover ? (
          <Image
            src={data.cover}
            alt={data.coverAlt ?? ''}
            widths={[800, 1200, 1600]}
            sizes="(min-width: 1152px) 1152px, 100vw"
            loading="eager"
            class="w-full rounded-2xl border border-line"
            data-reveal
          />
        ) : data.workflow.length === 0 ? (
          <div data-reveal>
            <ProjectCover category={data.category} class="rounded-2xl border border-line" />
          </div>
        ) : null
      }

      {data.workflow.length > 0 && <WorkflowDiagram steps={data.workflow} />}

      <Metrics metrics={data.metrics} />
    </div>

    <div class="container-page mt-6 grid gap-12 lg:grid-cols-[1fr_280px]">
      <div class="prose-body" data-reveal>
        <Content />
      </div>
      <aside class="space-y-6 lg:pt-12" data-reveal>
        {
          data.tools.length > 0 && (
            <div>
              <h2 class="text-sm font-semibold">Tools & features</h2>
              <ul class="mt-3 flex flex-wrap gap-2">
                {data.tools.map((tool) => (
                  <li class="badge">{tool}</li>
                ))}
              </ul>
            </div>
          )
        }
        {
          data.liveUrl && (
            <a href={data.liveUrl} target="_blank" rel="noopener" class="btn-secondary">
              View live project <Icon name="arrow-up-right" size={16} />
            </a>
          )
        }
      </aside>
    </div>

    {
      data.gallery.length > 0 && (
        <div class="container-page mt-12 grid gap-6 sm:grid-cols-2" data-reveal-stagger>
          {data.gallery.map((img) => (
            <Image
              src={img.src}
              alt={img.alt}
              widths={[600, 1000]}
              sizes="(min-width: 640px) 50vw, 100vw"
              class="w-full rounded-2xl border border-line"
            />
          ))}
        </div>
      )
    }

    {
      testimonial && (
        <div class="container-page mt-16">
          <div class="max-w-2xl" data-reveal>
            <TestimonialCard testimonial={testimonial} />
          </div>
        </div>
      )
    }
  </article>

  {
    next.id !== project.id && (
      <nav class="container-page mt-16" aria-label="Next project" data-reveal>
        <a
          href={`/work/${next.id}/`}
          class="group card flex items-center justify-between gap-6 p-6 transition-shadow hover:shadow-lg sm:p-8"
        >
          <span>
            <span class="text-sm text-muted">Next project</span>
            <span class="mt-1 block text-xl font-semibold tracking-tight">{next.data.title}</span>
          </span>
          <Icon name="arrow-right" size={24} class="shrink-0 text-accent transition-transform group-hover:translate-x-1" />
        </a>
      </nav>
    )
  }

  <CTA title="Have a similar problem?" />
</BaseLayout>
