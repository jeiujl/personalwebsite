---
import { getCollection } from 'astro:content';
import CTA from '../components/CTA.astro';
import PageHero from '../components/PageHero.astro';
import SampleBadge from '../components/SampleBadge.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

// TODO: your skills and the tools you use
const skills = [
  { group: 'Design', items: ['Website design', 'App & UI design', 'Prototyping', 'Branding basics'] },
  { group: 'Build', items: ['Websites', 'Online booking', 'Forms & payments', 'SEO basics'] },
  {
    group: 'Automation',
    items: ['CRM setup', 'Text & email follow-up', 'AI automations (Claude)', 'Integrations'],
  },
  { group: 'Tools', items: ['Figma', 'Claude', 'Zapier', 'Google Workspace'] },
];
---

<BaseLayout
  title="About"
  description={`About ${site.name}: designer and automation specialist helping small businesses grow.`}
>
  <PageHero eyebrow={`Hi, I'm ${site.name}`} title="About" />

  <div class="grid-lines">
    <section class="container-page grid gap-12 pt-16 lg:grid-cols-[1fr_320px]">
      <div data-reveal>
        <h2 class="heading text-4xl sm:text-5xl">Design and automation for businesses that would rather be doing the work.</h2>
        <!-- TODO: replace with your story, in your own voice -->
        <div class="prose-body mt-8">
          <p>
            I design websites and apps, and I build the automations that keep small businesses running smoothly
            behind the scenes: answering leads, following up, booking appointments and sending reminders.
          </p>
          <p>
            I got into this because I kept seeing great businesses lose customers for fixable reasons: an outdated
            website, a missed call, a follow-up nobody had time to send. My job is to fix those things so you can
            focus on the work you're good at.
          </p>
          <p>
            I keep things simple, explain everything in plain English, and stay around after launch. Most of my
            clients come through referrals, and I'd like to keep it that way.
          </p>
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-5">
          <a href="/contact" class="btn-signal" data-magnetic>
            Work with me <span class="text-accent" aria-hidden="true">↗</span>
          </a>
          {
            site.resumeUrl && (
              <a href={site.resumeUrl} class="arrow-link" download>
                Download resume <span class="arrow" aria-hidden="true">↓</span>
              </a>
            )
          }
        </div>
      </div>

      <div class="order-first lg:order-none" data-reveal>
        {
          site.photo ? (
            <img
              src={site.photo}
              alt={`Photo of ${site.name}`}
              width="320"
              height="400"
              class="aspect-[4/5] w-full max-w-xs border border-line object-cover grayscale"
            />
          ) : (
            <div
              data-surface="dark"
              class="monument flex aspect-[4/5] w-full max-w-xs items-center justify-center bg-bg text-8xl text-ink"
              aria-hidden="true"
            >
              {site.initials}
            </div>
          )
        }
        <p class="mono mt-4 text-[11px] text-muted">{site.location}</p>
      </div>
    </section>

    <section class="container-page pt-28">
      <div class="flex items-baseline justify-between gap-3 border-b border-ink/80 pb-4" data-reveal>
        <h2 class="heading text-4xl sm:text-5xl">Skills & tools</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {
          skills.map((s, i) => (
            <div class="border-b border-line py-6 sm:pr-6 lg:border-b-0 lg:border-l lg:px-5 lg:first:border-l-0 lg:first:pl-0">
              <p class="mono text-[11px] text-muted">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-2 font-medium">{s.group}</h3>
              <ul class="mt-3 space-y-1.5 text-[15px] text-muted">
                {s.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    {
      experience.length > 0 && (
        <section class="container-page pt-28">
          <div class="flex items-baseline justify-between gap-3 border-b border-ink/80 pb-4" data-reveal>
            <h2 class="heading text-4xl sm:text-5xl">Experience</h2>
          </div>
          <ol data-reveal-stagger>
            {experience.map((item) => (
              <li class="grid gap-2 border-b border-line py-6 sm:grid-cols-[180px_1fr] sm:gap-8">
                <div class="flex flex-wrap items-center gap-2">
                  <p class="mono text-[12px] text-muted">{item.data.period}</p>
                  {item.data.sample && <SampleBadge />}
                </div>
                <div>
                  <h3 class="text-xl font-medium tracking-[-0.02em]">
                    {item.data.role} <span class="text-muted">· {item.data.org}</span>
                  </h3>
                  <p class="mt-2 text-muted">{item.data.summary}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>

  <CTA />
</BaseLayout>
