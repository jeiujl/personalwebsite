---
// Static version of the automation network, shown when the 3D scene doesn't
// run (reduced motion, Save-Data, no GPU acceleration, no JavaScript).
import { iconPaths, type IconName } from '../lib/icons';

interface Props {
  nodes: { icon: IconName; label: string }[];
}
const { nodes } = Astro.props;
// Tile centers as percentages of the box (zig-zag, left to right)
const points = [
  [9, 62],
  [29, 28],
  [50, 70],
  [71, 30],
  [91, 64],
];
const curve = (a: number[], b: number[]) => {
  const mx = (a[0] + b[0]) / 2;
  const my = Math.min(a[1], b[1]) - 8;
  return `M ${a[0]} ${a[1]} Q ${mx} ${my} ${b[0]} ${b[1]}`;
};
---

<div class="relative aspect-[2.2/1] w-full" aria-hidden="true">
  <svg class="absolute inset-0 h-full w-full overflow-visible" viewBox="0 0 100 100" preserveAspectRatio="none">
    {
      points.slice(1).map((p, i) => (
        <path
          d={curve(points[i], p)}
          fill="none"
          stroke={i === 0 ? 'var(--accent)' : 'var(--ink)'}
          stroke-opacity={i === 0 ? 1 : 0.2}
          stroke-width="1.2"
          vector-effect="non-scaling-stroke"
        />
      ))
    }
  </svg>
  {
    nodes.map((node, i) => (
      <div
        class="absolute flex -translate-x-1/2 -translate-y-1/2 flex-col items-center gap-2"
        style={`left:${points[i][0]}%;top:${points[i][1]}%`}
      >
        <span
          class:list={[
            'flex size-11 items-center justify-center border bg-[#121311] sm:size-14',
            i < 2 ? 'border-accent text-accent' : 'border-line text-ink',
          ]}
        >
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d={iconPaths[node.icon]} />
          </svg>
        </span>
        <span class="mono hidden text-[10px] whitespace-nowrap text-muted sm:block">
          {String(i + 1).padStart(2, '0')} {node.label}
        </span>
      </div>
    ))
  }
</div>
