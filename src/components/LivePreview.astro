---
// The real demo site inside a browser frame. It only loads when the visitor
// asks, so the page stays fast; until then the cover stands in for it.
import { getImage } from 'astro:assets';
import { getLang, pick } from '../i18n';

interface Props {
  url: string;
  title: string;
  poster: ImageMetadata;
}
const { url, title, poster } = Astro.props;
const posterSrc = (await getImage({ src: poster, width: 1400, format: 'webp' })).src;
const t = pick(getLang(Astro.url), {
  en: { load: 'Try it here', hint: 'Loads the live site in this frame', open: 'Open in a new tab' },
  zh: { load: '在这里试试', hint: '在此框内加载在线网站', open: '在新标签页打开' },
});
---

<div data-surface="dark" class="overflow-hidden rounded-[14px] border border-line bg-bg" data-live-preview>
  <div class="flex h-10 items-center gap-2 border-b border-line px-4">
    <span class="size-2.5 shrink-0 rounded-full bg-line"></span>
    <span class="size-2.5 shrink-0 rounded-full bg-line"></span>
    <span class="size-2.5 shrink-0 rounded-full bg-line"></span>
    <span class="mono ml-3 min-w-0 truncate text-[11px] text-muted">{new URL(url).host}</span>
    <a href={url} target="_blank" rel="noopener" class="mono ml-auto shrink-0 text-[11px] text-muted hover:text-ink">
      {t.open} <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="relative aspect-[4/5] sm:aspect-[16/10]">
    <button
      type="button"
      class="group absolute inset-0 flex flex-col items-center justify-center gap-3 bg-cover bg-center"
      style={`background-image:linear-gradient(rgb(11 12 11 / 0.55), rgb(11 12 11 / 0.55)), url(${posterSrc})`}
      data-src={url}
      data-title={title}
    >
      <span class="btn-signal px-6 py-3 text-base">{t.load} <span class="text-accent" aria-hidden="true">↗</span></span>
      <span class="mono text-[11px] text-ink/80">{t.hint}</span>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-live-preview] button[data-src]').forEach((button) =>
    button.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = button.dataset.src!;
      frame.title = button.dataset.title!;
      frame.className = 'absolute inset-0 h-full w-full border-0 bg-[#131210]';
      frame.allow = 'fullscreen';
      button.replaceWith(frame);
      frame.focus();
    }),
  );
</script>
