---
interface Props {
  metrics: { value: string; label: string }[];
}
const { metrics } = Astro.props;
---

{
  metrics.length > 0 && (
    <dl class="grid border-t border-line sm:grid-cols-3" data-reveal-stagger>
      {metrics.map((m) => (
        <div class="flex flex-col-reverse border-b border-line py-6 sm:border-b-0 sm:border-l sm:px-6 sm:first:border-l-0 sm:first:pl-0">
          <dt class="mono mt-2 text-[12px] text-muted">{m.label}</dt>
          <dd class="heading text-5xl tabular-nums sm:text-6xl" data-count>
            {m.value}
          </dd>
        </div>
      ))}
    </dl>
  )
}
