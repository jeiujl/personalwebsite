---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  recipe: CollectionEntry<'automations'>;
}
const { name, trigger, action, benefit } = Astro.props.recipe.data;
---

<article class="card flex h-full flex-col p-6">
  <span class="inline-flex size-10 items-center justify-center rounded-xl bg-accent-soft text-accent">
    <Icon name="bolt" size={20} />
  </span>
  <h3 class="mt-4 font-semibold">{name}</h3>
  <dl class="mt-3 flex-1 space-y-2 text-sm">
    <div>
      <dt class="inline font-medium">When: </dt>
      <dd class="inline text-muted">{trigger}</dd>
    </div>
    <div>
      <dt class="inline font-medium">Then: </dt>
      <dd class="inline text-muted">{action}</dd>
    </div>
  </dl>
  <p class="mt-4 border-t border-line pt-4 text-sm font-semibold text-accent">{benefit}</p>
</article>
