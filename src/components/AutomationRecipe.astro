---
// Decide-style dark product card used as punctuation on the light pages,
// with a geometric line-art icon.
import type { CollectionEntry } from 'astro:content';

interface Props {
  recipe: CollectionEntry<'automations'>;
  index: number;
}
const { recipe, index } = Astro.props;
const { name, trigger, action, benefit } = recipe.data;
// A different arrangement of rings and lines per card
const variant = index % 4;
---

<article data-surface="dark" class="flex h-full flex-col border border-line bg-bg p-6">
  <div class="flex items-start justify-between">
    <p class="mono text-[11px] text-muted">Automation {String(index + 1).padStart(2, '0')}</p>
    <svg class="size-14 text-ink" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      <circle cx="28" cy="28" r="26" />
      {variant === 0 && <><circle cx="28" cy="28" r="14" /><path d="M2 28h52M28 2v52" /></>}
      {variant === 1 && <><circle cx="28" cy="28" r="18" /><circle cx="28" cy="28" r="9" /></>}
      {variant === 2 && <><path d="M8 40a26 26 0 0 1 40 0M8 16a26 26 0 0 0 40 0" /><circle cx="28" cy="28" r="3" /></>}
      {variant === 3 && <><path d="M10 10l36 36M46 10L10 46" /><circle cx="28" cy="28" r="12" /></>}
      <circle cx="28" cy="2" r="2" fill="#73ffb9" stroke="none" />
    </svg>
  </div>
  <h3 class="heading mt-8 text-2xl">{name}</h3>
  <dl class="mt-4 flex-1 space-y-3 text-[15px]">
    <div>
      <dt class="mono text-[11px] text-muted">When</dt>
      <dd class="mt-0.5 text-ink/85">{trigger}</dd>
    </div>
    <div>
      <dt class="mono text-[11px] text-muted">Then</dt>
      <dd class="mt-0.5 text-ink/85">{action}</dd>
    </div>
  </dl>
  <p class="mt-6 flex items-center gap-2 border-t border-line pt-4 text-[15px] font-medium">
    <span class="text-accent" aria-hidden="true">↗</span>
    {benefit}
  </p>
</article>
