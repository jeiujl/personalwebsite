---
// A row of big numbers that count up as they scroll in (motion.ts, data-count).
// Values live in site.stats.
import { site } from '../config/site';
---

{
  site.stats.length > 0 && (
    <section class="grid-lines border-b border-line" aria-label="At a glance">
      <dl class="container-page grid grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {site.stats.map((stat, i) => (
          <div
            class:list={[
              'flex flex-col-reverse justify-end gap-3 py-10 pr-4 sm:py-14',
              // 2 × 2 on phones, one row from lg: hairlines between cells only
              i % 2 === 1 && 'border-l border-line pl-5 sm:pl-8',
              i >= 2 && 'border-t border-line lg:border-t-0',
              i === 2 && 'lg:border-l lg:pl-8',
            ]}
          >
            <dt>
              <span class="mono block text-[12px] text-ink">{stat.label}</span>
              <span class="mt-1 block text-[14px] text-muted">{stat.note}</span>
            </dt>
            <dd class="monument text-[clamp(64px,8vw,112px)] text-ink tabular-nums" data-count>
              {stat.value}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )
}
