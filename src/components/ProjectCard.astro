---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { categoryLabels } from '../lib/content';
import Icon from './Icon.astro';
import ProjectCover from './ProjectCover.astro';
import SampleBadge from './SampleBadge.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h3' } = Astro.props;
const { title, client, summary, category, cover, coverAlt, sample } = project.data;
---

<article
  class="group card relative flex flex-col overflow-hidden transition-shadow hover:shadow-lg"
  data-category={category}
>
  {
    cover ? (
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="aspect-[16/10] w-full object-cover"
      />
    ) : (
      <ProjectCover category={category} />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-2">
      <span class="badge">{categoryLabels[category]}</span>
      {sample && <SampleBadge />}
    </div>
    <Heading class="mt-4 text-lg leading-snug font-semibold tracking-tight">
      <a href={`/work/${project.id}/`} class="after:absolute after:inset-0">
        {title}
      </a>
    </Heading>
    <p class="mt-1 text-sm text-muted">{client}</p>
    <p class="mt-3 text-sm leading-relaxed text-muted">{summary}</p>
    <span
      class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold text-accent"
      aria-hidden="true"
    >
      Read case study
      <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-0.5" />
    </span>
  </div>
</article>
