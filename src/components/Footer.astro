---
import { ctaHref, nav, site } from '../config/site';

const startLinks = [
  { label: 'Book a free call', href: ctaHref, rel: ctaHref.startsWith('http') ? 'noopener' : '' },
  { label: 'Send a message', href: '/contact', rel: '' },
  ...site.socials.map((s) => ({ label: s.label, href: s.href, rel: 'me noopener' })),
];
---

<footer data-surface="dark" data-band class="overflow-hidden border-t border-line bg-surface-2">
  <div class="container-page grid grid-cols-2 gap-x-6 gap-y-10 pt-16 pb-10 md:grid-cols-[2fr_1fr_1fr]">
    <div class="col-span-2 md:col-span-1">
      <p class="eyebrow">Get in touch</p>
      <a
        href={site.email ? `mailto:${site.email}` : '/contact'}
        class="mt-4 inline-block text-2xl font-medium tracking-[-0.02em] text-ink hover:text-accent sm:text-3xl"
      >
        {site.email || 'Send me a message ↗'}
      </a>
      <p class="mt-3 max-w-sm text-[15px] text-muted">{site.tagline}</p>
    </div>
    <nav aria-label="Footer">
      <p class="eyebrow">Pages</p>
      <ul class="mt-4 space-y-1">
        <li><a href="/" class="mono inline-block py-1.5 text-muted hover:text-ink">Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="mono inline-block py-1.5 text-muted hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div>
      <p class="eyebrow">Start a project</p>
      <ul class="mt-4 space-y-1">
        {
          startLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="mono inline-block py-1.5 text-muted hover:text-ink"
                {...(link.rel ? { rel: link.rel, target: '_blank' } : {})}
              >
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-page" aria-hidden="true">
    <p class="monument monument-fade text-[clamp(64px,15.5vw,210px)] whitespace-nowrap">
      {site.name}<span class="ml-[0.06em] align-top text-[0.42em] text-accent">✦</span>
    </p>
  </div>

  <div class="container-page mono flex flex-wrap justify-between gap-3 border-t border-line py-6 text-[11px] text-muted">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span>{site.location}</span>
  </div>
</footer>
