---
import { getCtaHref, getNav, getSite } from '../config/site';
import { getLang, localizePath, pick } from '../i18n';

const lang = getLang(Astro.url);
const site = getSite(lang);
const nav = getNav(lang);
const ctaHref = getCtaHref(lang);
const contactHref = localizePath('/contact', lang);
const t = pick(lang, {
  en: {
    book: 'Book a free call',
    message: 'Send a message',
    messageMe: 'Send me a message ↗',
    touch: 'Get in touch',
    pages: 'Pages',
    home: 'Home',
    start: 'Start a project',
  },
  zh: {
    book: '预约免费通话',
    message: '发送消息',
    messageMe: '给我发消息 ↗',
    touch: '联系我',
    pages: '页面',
    home: '首页',
    start: '开始合作',
  },
});

const startLinks = [
  { label: t.book, href: ctaHref, rel: ctaHref.startsWith('http') ? 'noopener' : '' },
  { label: t.message, href: contactHref, rel: '' },
  ...site.socials.map((s) => ({ label: s.label, href: s.href, rel: 'me noopener' })),
];
---

<footer data-surface="dark" data-band class="overflow-hidden border-t border-line bg-surface-2">
  <div class="container-page grid grid-cols-2 gap-x-6 gap-y-10 pt-16 pb-10 md:grid-cols-[2fr_1fr_1fr]">
    <div class="col-span-2 md:col-span-1">
      <p class="eyebrow">{t.touch}</p>
      <a
        href={site.email ? `mailto:${site.email}` : contactHref}
        class="mt-4 inline-block text-2xl font-medium tracking-[-0.02em] text-ink hover:text-accent sm:text-3xl"
      >
        {site.email || t.messageMe}
      </a>
      <p class="mt-3 max-w-sm text-[15px] text-muted">{site.tagline}</p>
    </div>
    <nav aria-label="Footer">
      <p class="eyebrow">{t.pages}</p>
      <ul class="mt-4 space-y-1">
        <li><a href={localizePath('/', lang)} class="mono inline-block py-1.5 text-muted hover:text-ink">{t.home}</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="mono inline-block py-1.5 text-muted hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div>
      <p class="eyebrow">{t.start}</p>
      <ul class="mt-4 space-y-1">
        {
          startLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="mono inline-block py-1.5 text-muted hover:text-ink"
                {...(link.rel ? { rel: link.rel, target: '_blank' } : {})}
              >
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-page" aria-hidden="true">
    <p class="monument monument-fade text-[clamp(64px,15.5vw,210px)] whitespace-nowrap">
      {site.name}<span class="ml-[0.06em] align-top text-[0.42em] text-accent">✦</span>
    </p>
  </div>

  <div class="container-page mono flex flex-wrap justify-between gap-3 border-t border-line py-6 text-[11px] text-muted">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span>{site.location}</span>
  </div>
</footer>
