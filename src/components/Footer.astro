---
import { nav, site } from '../config/site';
---

<footer class="mt-24 border-t border-line">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[2fr_1fr_1fr]">
    <div>
      <p class="font-semibold">{site.name}</p>
      <p class="mt-2 max-w-sm text-sm text-muted">{site.tagline}</p>
      <a href={`mailto:${site.email}`} class="mt-4 inline-block text-sm font-medium text-accent">
        {site.email}
      </a>
    </div>
    <nav aria-label="Footer">
      <p class="text-sm font-semibold">Pages</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink">Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div>
      <p class="text-sm font-semibold">Elsewhere</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        {
          site.socials.map((s) => (
            <li>
              <a href={s.href} class="hover:text-ink" rel="me noopener" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="container-page border-t border-line py-6 text-xs text-muted">
    © {new Date().getFullYear()} {site.name}. All rights reserved.
  </div>
</footer>
