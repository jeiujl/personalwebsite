---
import type { CollectionEntry } from 'astro:content';
import SampleBadge from './SampleBadge.astro';

interface Props {
  testimonial: CollectionEntry<'testimonials'>;
}
const { quote, name, title, company, sample } = Astro.props.testimonial.data;
const initials = name
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<figure class="card flex h-full flex-col p-6">
  <svg class="size-7 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M9.5 6C6.5 7.2 4.5 9.9 4.5 13.3V18h5.5v-5.5H7.3c0-2 1.1-3.6 3-4.4L9.5 6Zm9 0c-3 1.2-5 3.9-5 7.3V18H19v-5.5h-2.7c0-2 1.1-3.6 3-4.4L18.5 6Z"
    ></path>
  </svg>
  <blockquote class="mt-4 flex-1 text-base leading-relaxed text-pretty">
    <p>{quote}</p>
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-3">
    <span
      class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-surface-2 text-sm font-semibold text-muted"
      aria-hidden="true">{initials}</span
    >
    <span class="min-w-0 flex-1 text-sm">
      <span class="block font-semibold">{name}</span>
      <span class="block text-muted">{title}, {company}</span>
    </span>
    {sample && <SampleBadge />}
  </figcaption>
</figure>
