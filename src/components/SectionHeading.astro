---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
}
const { eyebrow, title, intro, align = 'left', as: Heading = 'h2' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading
    class:list={[
      'mt-2 font-semibold tracking-tight text-balance',
      Heading === 'h1' ? 'text-4xl sm:text-5xl' : 'text-3xl sm:text-4xl',
    ]}
  >
    {title}
  </Heading>
  {intro && <p class="mt-4 text-lg text-pretty text-muted">{intro}</p>}
  <slot />
</div>
