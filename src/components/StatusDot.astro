---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<p class="mono inline-flex items-center gap-2.5 text-muted">
  <span class="relative inline-flex size-2" aria-hidden="true">
    <span class="status-ring absolute inset-0 rounded-full bg-accent"></span>
    <span class="relative size-2 rounded-full bg-accent"></span>
  </span>
  {label}
</p>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .status-ring {
      animation: pulse-ring 1.8s var(--ease-settle) infinite;
    }
  }
</style>
