---
const steps = [
  { title: 'Free call', text: "A relaxed 20-minute chat about your business, what's working and what isn't." },
  { title: 'Clear proposal', text: "A plan in plain English: what I'll build, how long it takes, and the price." },
  { title: 'Design & build', text: 'I do the work and share progress along the way so you can give feedback early.' },
  { title: 'Launch & training', text: 'We go live together, and I show you and your team how everything works.' },
  { title: 'Ongoing support', text: "I'm here for changes, new automations and questions after launch." },
];
---

<ol class="grid border-t border-line sm:grid-cols-2 lg:grid-cols-5" data-reveal-stagger>
  {
    steps.map((step, i) => (
      <li class="border-b border-line py-6 lg:border-b-0 lg:border-l lg:px-5 lg:first:border-l-0 lg:first:pl-0">
        <span class:list={['block h-10 w-[3px]', i === 0 ? 'bg-accent' : 'bg-line']} aria-hidden="true" />
        <p class="mono mt-4 text-[11px] text-muted">{String(i + 1).padStart(2, '0')} / 05</p>
        <h3 class="mt-2 font-medium">{step.title}</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">{step.text}</p>
      </li>
    ))
  }
</ol>
