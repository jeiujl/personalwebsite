---
// Homepage hero visual. The static HeroVisual renders first (and stays for
// reduced-motion, Save-Data, low-power devices or no WebGL). Otherwise the
// interactive 3D automation network loads after the page and fades in on top.
import { iconPaths, type IconName } from '../lib/icons';
import HeroVisual from './HeroVisual.astro';

const steps: { icon: IconName; label: string; title: string; text: string }[] = [
  { icon: 'phone-call', label: 'Missed call', title: 'Missed call · 2:14 PM', text: 'Nobody could pick up' },
  { icon: 'message', label: 'Text back', title: 'Auto-text sent', text: '"Sorry we missed you! How can we help?"' },
  { icon: 'users', label: 'CRM', title: 'Lead added to your CRM', text: 'Tagged and placed in your pipeline' },
  { icon: 'calendar', label: 'Booked', title: 'Appointment booked', text: 'Tue 10:00 AM · reminder scheduled' },
  { icon: 'star', label: 'Review', title: 'Review requested', text: 'Sent automatically after the job' },
];
---

<div class="relative" data-hero-scene data-steps={JSON.stringify(steps)}>
  <div data-hero-fallback class="transition-opacity duration-700">
    <HeroVisual />
  </div>

  <div
    data-hero-stage
    class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-700"
    aria-hidden="true"
  >
    <div class="absolute -inset-3 rounded-[2rem] bg-accent-soft sm:-inset-6"></div>
    <div class="absolute -top-10 right-0 size-48 rounded-full bg-accent opacity-15 blur-3xl"></div>
    <div data-hero-canvas class="absolute inset-0"></div>

    <div
      class="absolute right-3 -bottom-8 left-3 flex items-center gap-3 rounded-2xl border border-line bg-surface p-3.5 shadow-lg sm:right-10 sm:left-10"
    >
      <span
        class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-accent text-accent-ink"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path data-caption-icon d={iconPaths[steps[0].icon]}></path>
        </svg>
      </span>
      <div class="min-w-0 flex-1 text-sm" data-caption-body>
        <p class="font-semibold" data-caption-title>{steps[0].title}</p>
        <p class="truncate text-muted" data-caption-text>{steps[0].text}</p>
      </div>
      <div class="hidden shrink-0 gap-1 sm:flex" data-caption-dots>
        {steps.map((_, i) => <span class:list={['size-1.5 rounded-full', i === 0 ? 'bg-accent' : 'bg-line']} />)}
      </div>
    </div>
  </div>
</div>

<script>
  import { iconPaths, type IconName } from '../lib/icons';

  type Step = { icon: IconName; label: string; title: string; text: string };

  const root = document.querySelector<HTMLElement>('[data-hero-scene]');

  function canRun() {
    // ?3d=1 forces the scene on (handy for demos and testing).
    if (new URLSearchParams(location.search).get('3d') === '1') return true;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
    const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
    if (nav.connection?.saveData) return false;
    if ((nav.hardwareConcurrency ?? 4) <= 2 || (nav.deviceMemory ?? 4) < 2) return false;
    try {
      // Skip devices without real GPU acceleration: software rendering would
      // make the page sluggish (it is also what speed tests like Lighthouse use).
      const canvas = document.createElement('canvas');
      const attrs = { failIfMajorPerformanceCaveat: true };
      const gl = (canvas.getContext('webgl2', attrs) ?? canvas.getContext('webgl', attrs)) as WebGLRenderingContext | null;
      if (!gl) return false;
      const info = gl.getExtension('WEBGL_debug_renderer_info');
      const renderer = info ? String(gl.getParameter(info.UNMASKED_RENDERER_WEBGL)) : '';
      gl.getExtension('WEBGL_lose_context')?.loseContext();
      return !/swiftshader|llvmpipe|software/i.test(renderer);
    } catch {
      return false;
    }
  }

  function whenIdle(fn: () => void) {
    const run = () => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1500 }) : setTimeout(fn, 200));
    document.readyState === 'complete' ? run() : addEventListener('load', run, { once: true });
  }

  if (root && canRun()) {
    const steps: Step[] = JSON.parse(root.dataset.steps ?? '[]');
    const fallback = root.querySelector<HTMLElement>('[data-hero-fallback]')!;
    const stage = root.querySelector<HTMLElement>('[data-hero-stage]')!;
    const canvasHost = root.querySelector<HTMLElement>('[data-hero-canvas]')!;
    const icon = root.querySelector('[data-caption-icon]')!;
    const body = root.querySelector<HTMLElement>('[data-caption-body]')!;
    const title = root.querySelector('[data-caption-title]')!;
    const text = root.querySelector('[data-caption-text]')!;
    const dots = [...root.querySelectorAll<HTMLElement>('[data-caption-dots] span')];

    const showStep = (i: number) => {
      const step = steps[i];
      icon.setAttribute('d', iconPaths[step.icon]);
      title.textContent = step.title;
      text.textContent = step.text;
      dots.forEach((dot, d) => {
        dot.classList.toggle('bg-accent', d === i);
        dot.classList.toggle('bg-line', d !== i);
      });
      body.animate(
        [
          { opacity: 0, transform: 'translateY(6px)' },
          { opacity: 1, transform: 'none' },
        ],
        { duration: 350, easing: 'cubic-bezier(.2,.7,.2,1)' },
      );
    };

    const io = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      io.disconnect();
      whenIdle(async () => {
        try {
          const { mount } = await import('../scripts/automation-scene');
          mount(canvasHost, {
            nodes: steps.map(({ icon, label }) => ({ icon, label })),
            onStep: showStep,
            onReady: () => {
              stage.classList.remove('opacity-0', 'pointer-events-none');
              fallback.classList.add('opacity-0');
            },
          });
        } catch (error) {
          // Keep the static illustration if anything goes wrong.
          console.warn('Hero scene unavailable', error);
        }
      });
    });
    io.observe(root);
  }
</script>
