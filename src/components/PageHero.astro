---
// Dark top band for inner pages: eyebrow, monument title, intro.
import Starfield from './Starfield.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  /** Shorter band for pages where the content should start sooner (e.g. Contact). */
  compact?: boolean;
}
const { eyebrow, title, intro, compact = false } = Astro.props;
---

<section
  data-surface="dark"
  data-band
  class:list={['relative overflow-hidden bg-bg', compact ? 'pt-10 pb-10 sm:pt-14 sm:pb-12' : 'pt-16 pb-14 sm:pt-24 sm:pb-20']}
>
  <Starfield count={70} seed={title.length * 13} />
  <div class="container-page relative">
    <p class="eyebrow" data-hero-item>{eyebrow}</p>
    <h1
      class:list={['monument mt-6', compact ? 'text-[clamp(60px,10vw,144px)]' : 'text-[clamp(72px,17vw,232px)]']}
      data-monument
    >
      {title.split('\n').map((line) => (
        <span class="block overflow-hidden pb-[0.04em]">
          <span class="monument-fade block" data-monument-line>{line}</span>
        </span>
      ))}
    </h1>
    {
      intro && (
        <div
          class:list={['grid gap-6 border-t border-line md:grid-cols-[1fr_auto] md:items-end', compact ? 'mt-6 pt-5' : 'mt-10 pt-6']}
          data-hero-item
        >
          <p class="max-w-xl text-lg text-pretty text-muted">{intro}</p>
          <slot />
        </div>
      )
    }
  </div>
</section>
