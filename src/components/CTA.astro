---
import { ctaHref, site } from '../config/site';
import Starfield from './Starfield.astro';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Let's talk",
  text = "Tell me what's slowing you down. In a free 20-minute call I'll suggest where a better website or a few automations would make the biggest difference. No pressure, no jargon.",
} = Astro.props;
---

<section data-surface="dark" data-band class="relative mt-24 overflow-hidden bg-bg py-20 sm:py-28">
  <Starfield count={60} seed={41} />
  <div class="container-page relative" data-reveal>
    <p class="eyebrow">Next step</p>
    <a href={ctaHref} class="group mt-6 flex items-start gap-3 sm:gap-6">
      <h2 class="monument monument-fade text-[clamp(72px,16vw,224px)]">{title}</h2>
      <span
        class="monument text-[clamp(48px,10vw,140px)] text-accent transition-transform duration-500 ease-[var(--ease-settle)] group-hover:translate-x-2 group-hover:-translate-y-2"
        aria-hidden="true">↗</span
      >
    </a>
    <div class="mt-10 grid gap-6 border-t border-line pt-6 md:grid-cols-[1fr_auto] md:items-center">
      <p class="max-w-xl text-pretty text-muted">{text}</p>
      <div class="flex flex-wrap gap-3">
        <a href={ctaHref} class="btn-signal" data-magnetic>
          Book a free call <span class="text-accent" aria-hidden="true">↗</span>
        </a>
        <a href={`mailto:${site.email}`} class="btn-ghost" data-magnetic>Email me</a>
      </div>
    </div>
  </div>
</section>
