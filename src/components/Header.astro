---
import { getCtaHref, getNav, site } from '../config/site';
import { getLang, languages, localizePath, pick, switchLangPath } from '../i18n';

const lang = getLang(Astro.url);
const other = lang === 'en' ? 'zh' : 'en';
const nav = getNav(lang);
const ctaHref = getCtaHref(lang);
const home = localizePath('/', lang);
const switchHref = switchLangPath(Astro.url.pathname, other);
const t = pick(lang, {
  en: { book: 'Book a call', bookFree: 'Book a free call', home: 'Home', menu: 'Menu', close: 'Close', switchTo: 'Switch to Chinese' },
  zh: { book: '预约通话', bookFree: '预约免费通话', home: '首页', menu: '菜单', close: '关闭', switchTo: '切换到英文' },
});

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header
  id="site-header"
  data-surface="dark"
  class="sticky top-0 z-50 border-b border-line/50 bg-bg transition-colors duration-300"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={home} class="flex items-center gap-2 text-[16px] font-semibold tracking-[-0.02em] text-ink">
      {site.name}
      <span class="text-accent" aria-hidden="true">✦</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1.5 md:flex">
      {
        nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'mono flex items-center gap-1.5 rounded-full border px-3 py-[7px] text-[12px] leading-none transition-colors',
                active ? 'border-ink/40 text-ink' : 'border-transparent text-muted hover:border-line hover:text-ink',
              ]}
            >
              <span class:list={[active ? 'text-accent' : 'text-muted']} aria-hidden="true">
                {active ? '•' : '+'}
              </span>
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      {/* Language toggle: the same page in the other language */}
      <a
        href={switchHref}
        hreflang={languages[other].hreflang}
        lang={languages[other].htmlLang}
        aria-label={t.switchTo}
        title={t.switchTo}
        data-lang-switch={other}
        class="mono flex min-h-10 min-w-10 items-center justify-center rounded-full border border-line px-3 py-2 text-[12px] leading-none text-ink transition-colors hover:border-ink"
      >
        {languages[other].label}
      </a>
      <a href={ctaHref} class="btn-signal min-h-10 px-3.5 py-2 text-[13px] sm:px-4 sm:text-[14px]">
        {t.book} <span class="hidden text-accent sm:inline" aria-hidden="true">↗</span>
      </a>
      <button
        type="button"
        id="menu-button"
        class="mono min-h-10 rounded-full border border-line px-4 py-2 text-[12px] leading-none text-ink md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-open-label={t.close}
        data-closed-label={t.menu}
      >
        {t.menu}
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  data-surface="dark"
  class="fixed inset-0 z-40 hidden flex-col bg-bg pt-20 md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label={t.menu}
>
  <nav aria-label="Mobile" class="container-page flex flex-1 flex-col justify-center gap-1">
    <a href={home} class="monument text-[clamp(56px,17vw,96px)] text-ink">{t.home}</a>
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={['monument text-[clamp(56px,17vw,96px)]', isActive(item.href) ? 'text-accent' : 'text-ink']}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="container-page flex flex-wrap items-center gap-3 border-t border-line py-6">
    <a href={ctaHref} class="btn-signal">{t.bookFree} <span class="text-accent" aria-hidden="true">↗</span></a>
    {site.email && <a href={`mailto:${site.email}`} class="arrow-link">{site.email}</a>}
  </div>
</div>

<script>
  // Mobile menu
  const button = document.getElementById('menu-button')!;
  const menu = document.getElementById('mobile-menu')!;
  const setOpen = (open: boolean) => {
    button.setAttribute('aria-expanded', String(open));
    button.textContent = (open ? button.dataset.openLabel : button.dataset.closedLabel) ?? '';
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

  // Match the header to whatever surface sits underneath it: dark over the
  // heroes and bands, light over the pages.
  const header = document.getElementById('site-header')!;
  const darkSections = [...document.querySelectorAll('[data-band][data-surface="dark"]')];
  const under = new Set<Element>();
  let observer: IntersectionObserver | undefined;
  const watch = () => {
    observer?.disconnect();
    under.clear();
    // A 1px line just under the header's bottom edge decides its look.
    const edge = header.offsetHeight;
    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? under.add(e.target) : under.delete(e.target)));
        header.dataset.surface = under.size ? 'dark' : 'light';
      },
      { rootMargin: `-${edge}px 0px -${Math.max(0, window.innerHeight - edge - 1)}px 0px` },
    );
    darkSections.forEach((section) => observer!.observe(section));
  };
  watch();
  addEventListener('resize', watch, { passive: true });
</script>
