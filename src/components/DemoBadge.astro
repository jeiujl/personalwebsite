---
// Shown on demo projects (concept: true): sample builds for fictional companies.
import { getLang, pick } from '../i18n';

const t = pick(getLang(Astro.url), {
  en: { label: 'Demo build', title: 'A sample build for a fictional company' },
  zh: { label: '演示项目', title: '为虚构公司制作的示例项目' },
});
---

<span
  class="mono inline-flex items-center gap-1.5 rounded-full border border-dashed border-accent/70 px-2 py-[3px] text-[10px] leading-none text-accent"
  title={t.title}
>
  <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
  {t.label}
</span>
