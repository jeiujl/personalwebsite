---
// GSAP-style "tool feature" row: a small looping animation of the service
// (ServiceScene), the colored service label, a heading, copy and an outlined
// Explore pill.
import type { CollectionEntry } from 'astro:content';
import { getLang, localizePath, pick } from '../i18n';
import { disciplineLabel, disciplines } from '../lib/disciplines';
import ServiceScene from './ServiceScene.astro';

interface Props {
  service: CollectionEntry<'services'>;
  index: number;
}
const { service, index } = Astro.props;
const { title, summary, idealFor, discipline } = service.data;
const lang = getLang(Astro.url);
const { hue } = disciplines[discipline];
const label = disciplineLabel(discipline, lang);
const t = pick(lang, { en: { ideal: 'Ideal for · ', explore: 'Explore' }, zh: { ideal: '适合 · ', explore: '了解更多' } });
const flip = index % 2 === 1;
---

<article class="grid items-center gap-8 border-t border-line py-10 md:grid-cols-12 md:gap-12 md:py-14" data-reveal>
  <div class:list={['md:col-span-5', flip && 'md:order-2 md:col-start-8']}>
    <div class="relative mx-auto aspect-[5/4] w-full max-w-[22rem]" style={`--hue:${hue}`}>
      <ServiceScene discipline={discipline} />
    </div>
  </div>
  <div class:list={['md:col-span-6', flip ? 'md:order-1 md:col-start-1' : 'md:col-start-7']}>
    <p class="mono flex items-center gap-2 text-[12px]">
      <span class="tag-dot size-2" style={`background:${hue}`}></span>
      <span class="text-muted">{String(index + 1).padStart(2, '0')}</span>
      {label}
    </p>
    <h3 class="heading mt-5 text-4xl sm:text-5xl">{title}</h3>
    <p class="mt-5 max-w-xl text-lg text-muted">{summary}</p>
    <p class="mt-4 max-w-xl text-[15px]"><span class="mono text-[11px] text-muted">{t.ideal}</span>{idealFor}</p>
    <div class="mt-8 flex flex-wrap items-center gap-5">
      <a href={localizePath(`/services#${service.id}`, lang)} class="btn-ghost">{t.explore} <span class="text-accent" aria-hidden="true">↗</span></a>
    </div>
  </div>
</article>
