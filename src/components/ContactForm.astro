---
import { actions, isInputError } from 'astro:actions';
import { getLang, pick } from '../i18n';
import { budgetRanges, inquiryTypes, optionLabelsZh, timelines } from '../lib/inquiry';
import Icon from './Icon.astro';

const lang = getLang(Astro.url);
const option = (value: string) => (lang === 'zh' ? (optionLabelsZh[value] ?? value) : value);
const t = pick(lang, {
  en: {
    thanks: 'Thanks, your message is on its way.',
    reply: "I'll get back to you as soon as I can.",
    name: 'Your name',
    email: 'Email',
    company: 'Business name',
    optional: '(optional)',
    need: 'What do you need?',
    choose: 'Choose one…',
    budget: 'Budget',
    noBudget: 'Prefer not to say',
    timeline: 'Timeline',
    noTimeline: 'Not sure',
    message: "Tell me about your business and what you'd like to fix",
    placeholder: 'e.g. We miss a lot of calls during the day and our website is outdated…',
    send: 'Send message',
    sending: 'Sending…',
    failed: 'Something went wrong. Please try again.',
    // Server messages are already in English
    errors: {} as Record<string, string>,
  },
  zh: {
    thanks: '谢谢，你的消息已发出。',
    reply: '我会尽快回复你。',
    name: '你的名字',
    email: '邮箱',
    company: '公司名称',
    optional: '（选填）',
    need: '你需要什么？',
    choose: '请选择…',
    budget: '预算',
    noBudget: '暂不透露',
    timeline: '时间',
    noTimeline: '还不确定',
    message: '介绍一下你的业务，以及你想解决的问题',
    placeholder: '例如：我们白天经常漏接电话，网站也比较旧了…',
    send: '发送消息',
    sending: '发送中…',
    failed: '出了点问题，请再试一次。',
    errors: {
      name: '请告诉我你的名字。',
      email: '请输入有效的邮箱地址。',
      service: '请选择你需要哪方面的帮助。',
      message: '请简单介绍一下你的项目（10 到 5,000 字）。',
    } as Record<string, string>,
  },
});
// Field errors in the page's language (the action's own messages are English)
const errorFor = (field: string, message?: string) => (message ? (t.errors[field] ?? message) : '');

// Without JavaScript the form posts to the action and this (server-rendered)
// page shows the result. With JavaScript the script below submits in place.
const result = Astro.getActionResult(actions.contact);
const fieldErrors = result?.error && isInputError(result.error) ? result.error.fields : {};
const formError = result?.error && !isInputError(result.error) ? result.error.message : '';
const sent = result?.data?.ok === true;

const params = Astro.url.searchParams;
const preselected = params.get('service') ?? '';
const ref = params.get('ref') ?? '';

const fieldClass =
  'mt-2 block w-full border border-line bg-surface px-3.5 py-3 text-base text-ink placeholder:text-muted/70 focus:border-ink focus:outline-none';
const labelClass = 'mono block text-[12px] text-ink';
const errorClass = 'mt-1.5 text-sm text-danger';
---

<div id="contact-success" class:list={['card p-8 text-center', !sent && 'hidden']} role="status">
  <span
    class="mx-auto inline-flex size-12 items-center justify-center rounded-full border border-accent text-accent"
  >
    <Icon name="check" size={24} />
  </span>
  <h2 class="heading mt-4 text-2xl">{t.thanks}</h2>
  <p class="mt-2 text-muted">{t.reply}</p>
</div>

<form
  id="contact-form"
  method="POST"
  action={actions.contact}
  class:list={['card space-y-5 p-6 sm:p-8', sent && 'hidden']}
  data-errors={JSON.stringify(t.errors)}
  data-sending={t.sending}
  data-send={t.send}
  data-failed={t.failed}
>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="name" class={labelClass}>{t.name}</label>
      <input id="name" name="name" type="text" autocomplete="name" required minlength="2" class={fieldClass} />
      <p class={errorClass} data-error-for="name">{errorFor('name', fieldErrors.name?.[0])}</p>
    </div>
    <div>
      <label for="email" class={labelClass}>{t.email}</label>
      <input id="email" name="email" type="email" autocomplete="email" required class={fieldClass} />
      <p class={errorClass} data-error-for="email">{errorFor('email', fieldErrors.email?.[0])}</p>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="company" class={labelClass}>
        {t.company} <span class="text-muted">{t.optional}</span>
      </label>
      <input id="company" name="company" type="text" autocomplete="organization" class={fieldClass} />
    </div>
    <div>
      <label for="service" class={labelClass}>{t.need}</label>
      <select id="service" name="service" required class={fieldClass}>
        <option value="" disabled selected={!preselected}>{t.choose}</option>
        {
          inquiryTypes.map((type) => (
            <option value={type} selected={type === preselected}>
              {option(type)}
            </option>
          ))
        }
      </select>
      <p class={errorClass} data-error-for="service">{errorFor('service', fieldErrors.service?.[0])}</p>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="budget" class={labelClass}>
        {t.budget} <span class="text-muted">{t.optional}</span>
      </label>
      <select id="budget" name="budget" class={fieldClass}>
        <option value="">{t.noBudget}</option>
        {budgetRanges.map((b) => <option value={b}>{option(b)}</option>)}
      </select>
    </div>
    <div>
      <label for="timeline" class={labelClass}>
        {t.timeline} <span class="text-muted">{t.optional}</span>
      </label>
      <select id="timeline" name="timeline" class={fieldClass}>
        <option value="">{t.noTimeline}</option>
        {timelines.map((value) => <option value={value}>{option(value)}</option>)}
      </select>
    </div>
  </div>

  <div>
    <label for="message" class={labelClass}>{t.message}</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      minlength="10"
      class={fieldClass}
      placeholder={t.placeholder}></textarea>
    <p class={errorClass} data-error-for="message">{errorFor('message', fieldErrors.message?.[0])}</p>
  </div>

  <!-- Referral source (from links like /?ref=dad) and spam traps -->
  <input type="hidden" name="ref" value={ref} />
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="startedAt" value={Date.now()} />
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label for="website">Leave this empty</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <p id="form-error" class={errorClass} role="alert">{formError}</p>

  <button type="submit" class="btn-signal w-full py-3.5 text-base sm:w-auto">
    <span class="submit-label">{t.send}</span>
    <span class="text-accent" aria-hidden="true">↗</span>
  </button>
</form>

<script>
  import { actions, isInputError } from 'astro:actions';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('contact-success');
  const formError = document.getElementById('form-error');

  if (form) {
    const refInput = form.elements.namedItem('ref') as HTMLInputElement;
    const translated: Record<string, string> = JSON.parse(form.dataset.errors ?? '{}');
    try {
      refInput.value ||= localStorage.getItem('ref') ?? '';
    } catch {}

    const showErrors = (fields: Record<string, string[] | undefined>) => {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        const field = el.dataset.errorFor!;
        const message = fields[field]?.[0] ? (translated[field] ?? fields[field]![0]) : '';
        el.textContent = message;
        const input = form.elements.namedItem(el.dataset.errorFor!) as HTMLElement | null;
        input?.setAttribute('aria-invalid', message ? 'true' : 'false');
      });
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const label = button.querySelector('.submit-label')!;
      button.disabled = true;
      label.textContent = form.dataset.sending!;
      formError!.textContent = '';

      const { data, error } = await actions.contact(new FormData(form));

      button.disabled = false;
      label.textContent = form.dataset.send!;

      if (error) {
        if (isInputError(error)) {
          showErrors(error.fields);
          form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        } else {
          showErrors({});
          formError!.textContent = error.message || form.dataset.failed!;
        }
        return;
      }

      if (data?.ok) {
        form.classList.add('hidden');
        success?.classList.remove('hidden');
        success?.scrollIntoView({ block: 'center' });
      }
    });
  }
</script>
