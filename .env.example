# Contact form email delivery (https://resend.com). Set these in
# Vercel → Project → Settings → Environment Variables, or in a local .env file.
RESEND_API_KEY=
# Where inquiries are delivered. With the default sender below this must be the
# email address that owns your Resend account.
CONTACT_TO_EMAIL=
# Sender. Leave unset to use Resend's test sender; after verifying your domain
# in Resend use something like: Your Name <hello@yourdomain.com>
CONTACT_FROM_EMAIL=

# Optional: your custom domain, used for canonical URLs and the sitemap.
# SITE_URL=https://yourdomain.com
